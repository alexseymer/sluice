# Sluice environment variables — used by Docker Compose (`env_file: .env`).
# Create with: cp .env.example .env
# Prefer: docker compose run --rm sluice setup
# Never commit real secrets.

# --- Core (container defaults match the image) ---
SLUICE_DATA_DIR=/data
SLUICE_DATABASE_URL=sqlite+aiosqlite:////data/sluice.db
SLUICE_LOG_LEVEL=INFO

# --- Jour fixe ---
SLUICE_JOUR_FIXE_CRON=0 9 * * *
SLUICE_JOUR_FIXE_TIMEOUT_MINUTES=60
SLUICE_JOUR_FIXE_SCHEDULER_ENABLED=true
SLUICE_PLAN_AUTO_APPROVE=false
SLUICE_DISPATCH_POLL_SECONDS=30
SLUICE_FORGE_SYNC_POLL_SECONDS=60

# --- Chat (Phase 1: matrix) ---
# Prefer `sluice setup` over filling these by hand — it creates the bot + room.
SLUICE_CHAT_BACKEND=matrix
SLUICE_MATRIX_HOMESERVER=https://matrix.example.com
SLUICE_MATRIX_ROOM_ID=!room:example.com
SLUICE_MATRIX_ACCESS_TOKEN=
SLUICE_MATRIX_USER_ID=@bot:example.com
SLUICE_MATRIX_ALLOWED_SENDER=@you:example.com
# Must stay under your reverse-proxy idle timeout (often ~10s) or sync 504s
# and the bot will not see room messages.
SLUICE_MATRIX_SYNC_TIMEOUT_MS=8000
# Saved by setup when a new bot is created — used to re-login if the account already exists.
SLUICE_MATRIX_BOT_PASSWORD=
# Saved by setup so re-runs can keep the operator password (Enter to reuse).
SLUICE_MATRIX_OPERATOR_PASSWORD=

# --- Forge (Phase 1: github) ---
# Prefer `sluice setup` (GitHub device flow) over pasting a PAT.
SLUICE_FORGE_BACKEND=github
SLUICE_GITHUB_OWNER=
SLUICE_GITHUB_REPO=
SLUICE_GITHUB_TOKEN=
# Public OAuth App client ID (Device Flow enabled). Not a secret.
# Create at https://github.com/settings/developers — callback can be http://127.0.0.1
SLUICE_GITHUB_OAUTH_CLIENT_ID=
# Cursor MCP (`.cursor/mcp.json`) — set in your shell or here for local tooling.
# Prefer the same PAT as SLUICE_GITHUB_TOKEN for agent GitHub tools.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- AI backends (comma-separated: claude_code,cursor,agy,codex) ---
# On Docker start, Sluice installs enabled Linux CLIs into /data/home and
# posts subscription login links to Matrix (Cursor: open link; agy: open link
# + reply with the verification code). No metered chat API.
# SLUICE_PLANNER_BACKEND is used for mid-session chat AND final plan structuring
# (falls back to SLUICE_DEFAULT_BACKEND, then the first entry in SLUICE_AI_BACKENDS).
SLUICE_AI_BACKENDS=cursor,agy
SLUICE_DEFAULT_BACKEND=
SLUICE_PLANNER_BACKEND=cursor
# Orchestrator shapes jour fixe into GitHub issues; reviewer checks worker output.
# Defaults: orchestrator → planner_backend → default_backend → first in SLUICE_AI_BACKENDS.
SLUICE_ORCHESTRATOR_BACKEND=
SLUICE_REVIEWER_BACKEND=
SLUICE_MAX_REVIEW_ITERATIONS=3
SLUICE_CLI_BOOTSTRAP_ENABLED=true
SLUICE_CLI_AUTH_TIMEOUT_SECONDS=900
SLUICE_BUDGET_SAFETY_MARGIN=0.85
SLUICE_BACKEND_DISPATCH_TIMEOUT_SECONDS=3600

# Claude Code
SLUICE_CLAUDE_CODE_CLI_PATH=claude
# Cautious starting points — Sluice probes beyond these until a quota error,
# then learns the real limit for the window.
SLUICE_CLAUDE_CODE_MAX_REQUESTS=50
SLUICE_CLAUDE_CODE_WINDOW_SECONDS=18000
SLUICE_CLAUDE_CODE_SKIP_PERMISSIONS=true

# Cursor Agent CLI
SLUICE_CURSOR_CLI_PATH=agent
SLUICE_CURSOR_MAX_REQUESTS=200
SLUICE_CURSOR_WINDOW_SECONDS=2592000
SLUICE_CURSOR_OUTPUT_FORMAT=text
SLUICE_CURSOR_FORCE=true
SLUICE_CURSOR_TRUST_WORKSPACE=true

# Antigravity CLI (agy)
SLUICE_AGY_CLI_PATH=agy
SLUICE_AGY_MAX_REQUESTS=20
SLUICE_AGY_WINDOW_SECONDS=86400
SLUICE_AGY_MODE=accept-edits
SLUICE_AGY_SKIP_PERMISSIONS=true

# OpenAI Codex CLI
SLUICE_CODEX_CLI_PATH=codex
SLUICE_CODEX_MAX_REQUESTS=50
SLUICE_CODEX_WINDOW_SECONDS=18000
SLUICE_CODEX_SANDBOX=workspace-write
SLUICE_CODEX_EPHEMERAL=true
SLUICE_CODEX_SKIP_GIT_REPO_CHECK=true

# --- Worktrees ---
SLUICE_WORKTREE_BASE_DIR=/data/worktrees
